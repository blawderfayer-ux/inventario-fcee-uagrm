# ---------------------------------------------------------------------------
# MongoDB
# ---------------------------------------------------------------------------
# Cadena de conexión de MongoDB Atlas o de una instancia local.
# Atlas:  mongodb+srv://usuario:clave@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# Local:  mongodb://127.0.0.1:27017
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=inventario_fcee

# ---------------------------------------------------------------------------
# NextAuth / Auth.js
# ---------------------------------------------------------------------------
# Genera un secreto con:  npx auth secret     (o)   openssl rand -base64 32
AUTH_SECRET=

# URL pública de la app. En local déjala así; en producción usa el dominio real.
NEXTAUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Google OAuth  (console.cloud.google.com > APIs y servicios > Credenciales)
# Origen autorizado:        http://localhost:3000
# URI de redirección:       http://localhost:3000/api/auth/callback/google
# ---------------------------------------------------------------------------
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ---------------------------------------------------------------------------
# Roles
# ---------------------------------------------------------------------------
# Correos que entran directamente como Super Administrador, separados por coma.
# Si la colección de usuarios está vacía, el PRIMER usuario que inicie sesión
# se convierte en admin automáticamente.
ADMIN_EMAILS=
